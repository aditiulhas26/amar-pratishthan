# Copy this file to ".env" and fill in your own values. NEVER upload .env to GitHub.

PORT=3000

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/amar-pratishthan?retryWrites=true&w=majority

# --- Admin login for /admin.html ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password
# Long random text used to sign login cookies. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=paste-the-random-text-here

# --- Photo storage (Cloudinary dashboard) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Enquiry emails (Brevo) ---
BREVO_API_KEY=
# Email that RECEIVES enquiries:
ADMIN_EMAIL=pratishthanamar@gmail.com
# Sender address - must be verified in Brevo (use the same Gmail):
MAIL_FROM=pratishthanamar@gmail.com
